DATABASE_URL=postgres://drydock:drydock_local_dev@localhost:5432/drydock
PORT=5299

# Allowed web origins, for CORS. Comma-separated. Defaults to the standalone
# harness's dev port (5199) and Blackbird's by-convention port (5181) when unset.
DRYDOCK_WEB_ORIGIN=http://127.0.0.1:5199,http://127.0.0.1:5181

# Required for the agent loop (/api/agent/generate, /api/agent/rewrite).
# Use OPENAI_BASE_URL for any OpenAI-compatible endpoint, including the local
# Wonderful-backed adapter at http://127.0.0.1:5399/v1.
OPENAI_API_KEY=
OPENAI_BASE_URL=
# Optional; defaults to gpt-4.1 when unset.
OPENAI_MODEL=
