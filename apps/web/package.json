{
	"name": "@drydock/web",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "Drydock's browser app: compiles a multi-file TSX prototype in-page against the real design system and mounts it on the Wonderful app runtime, with no sandbox and no server build.",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"typecheck": "tsc --noEmit",
		"test": "node --test src/**/*.test.ts",
		"verify": "node scripts/verify.ts",
		"verify:anchoring": "node scripts/verify-anchoring.ts"
	},
	"dependencies": {
		"@drydock/prototype": "workspace:*",
		"@tanstack/react-query": "^5.90.20",
		"@wonderful/theme": "workspace:*",
		"@wonderful/ui": "workspace:*",
		"react": "^19.2.7",
		"react-dom": "^19.2.7"
	},
	"devDependencies": {
		"@babel/standalone": "^7.29.6",
		"@tailwindcss/vite": "^4.3.1",
		"@types/babel__standalone": "^7.1.9",
		"@types/node": "^22.13.10",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.3",
		"esbuild-wasm": "0.25.12",
		"playwright": "1.60.0",
		"react-router": "^8.3.0",
		"tailwindcss": "^4.3.1",
		"typescript": "^5.9.3",
		"vite": "^8.1.0"
	}
}
